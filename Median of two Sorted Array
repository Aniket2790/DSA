class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int n = nums1.length;
        int m=nums2.length;
        int arr[]=new int[n+m];//temp

        int i=0;//nums1 pointer 
        int j=0;//nums2 pointer
        int k=0;//temppointer

        while(i<n && j<m){
            if(nums1[i] < nums2[j]){
                arr[k]= nums1[i];
                i++;
                k++;
            }else{
                arr[k]= nums2[j];
                k++;
                j++;
                
            }
        }
        while(i<n){
            arr[k]=nums1[i];
            i++;
            k++;
        }

        while(j<m){
            arr[k]=nums2[j];
            j++;
            k++;
        }
        int size = m+n;
        if(size%2==1){
            return arr[size/2];
        }
        return (arr[size/2]+arr[(size/2)-1])/2.0;

    }
}
