class Solution {
    final  int N= 5000000;
    public int countPrimes(int n) {

        
        boolean arr[] = new boolean[N];

        for ( int i =2 ; i< n ;i ++){
            arr[i]= true;
        } 
        for ( long i= 2 ; i < n ;i++){
            for ( long j= i*i ; j < n ; j=j+i){

                arr[(int) j] = false;
            }
        }
         int count = 0;

         for (int i= 0;i< n ; i++){
            if (arr[i] == true){
                count++;
            }
         }
         return count;
    }
}
