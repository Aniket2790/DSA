class Solution {
    public int maxPoints(int[][] points) {
        int n=points.length;

        if( n == 1){
            return 1;
        }
       int   result = 0;

       for (int i = 0; i< n; i++){ // point 1
         for  ( int j= i+1 ;j< n ; j++){ // point 2
             int count = 2;
              int dx= points[j][0] - points[i][0];  //(x2-x1)

              int dy= points[j][1] - points [i][1]; // (y2-y1)
            /*
            slope = dy/dx (/ is very expensive to use )

            dy/dx=dy-/dx-

            dy*dx_dx*dy_

            */

              for( int k = 0 ; k < n ; k++){
                if( k!=i && k!=j){
                    int dx_ = points[k][0] - points[i][0];//(x3-x1)
                    int dy_= points[k][1] - points [i][1]; //( y3-y1)

                    if( dy* dx_== dx*dy_){
                        count++;
                    }
                }
              }
              result = Math.max(result,count);
         }
       }
            return result;
    }
}
